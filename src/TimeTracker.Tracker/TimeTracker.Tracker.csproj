<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <ApplicationTitle>TimeTracker Pro</ApplicationTitle>
    <AssemblyName>TimeTracker</AssemblyName>
    <Version>2.1.1</Version>
    <AssemblyVersion>2.1.1.0</AssemblyVersion>
    <FileVersion>2.1.1.0</FileVersion>
    <InformationalVersion>2.1.1</InformationalVersion>
    <!-- Evita conflito com entry WinForms (não usar top-level Program do template Web) -->
    <EnableDefaultContentItems>true</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimeTracker.Core\TimeTracker.Core.csproj" />
    <ProjectReference Include="..\TimeTracker.Dashboard\TimeTracker.Dashboard.csproj" />
    <!-- Garante restore/build do helper no grafo do Tracker (CI/release). -->
    <ProjectReference Include="..\TimeTracker.UpdateHelper\TimeTracker.UpdateHelper.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- O NuGet do WebView2 referencia também Wpf.dll (WindowsBase 5.x) → MSB3277 no net8.
       Usamos só WinForms; remove a referência WPF antes da resolução de assemblies. -->
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="$([System.String]::Copy('%(Identity)').Contains('Microsoft.Web.WebView2.Wpf'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="..\..\assets\app.ico" Link="app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\TimeTracker.Dashboard\wwwroot\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Referência ao Dashboard copia o apphost; o release usa um único processo (Tracker). -->
  <Target Name="RemoveDashboardAppHost" AfterTargets="Build">
    <Delete Files="$(OutputPath)TimeTracker.Dashboard.exe;$(OutputPath)TimeTracker.Dashboard.runtimeconfig.json;$(OutputPath)Microsoft.Web.WebView2.Wpf.dll;$(OutputPath)Microsoft.Web.WebView2.Wpf.xml" TreatErrorsAsWarnings="true" />
  </Target>
  <Target Name="RemoveDashboardAppHostOnPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)TimeTracker.Dashboard.exe;$(PublishDir)TimeTracker.Dashboard.runtimeconfig.json;$(PublishDir)Microsoft.Web.WebView2.Wpf.dll;$(PublishDir)Microsoft.Web.WebView2.Wpf.xml" TreatErrorsAsWarnings="true" />
  </Target>

  <!-- UpdateHelper ao lado do exe (auto-update espera o PID antes do Setup). -->
  <Target Name="BuildAndCopyUpdateHelper" AfterTargets="Build">
    <ItemGroup>
      <_UpdateHelperBuild Include="..\TimeTracker.UpdateHelper\bin\$(Configuration)\net8.0\TimeTracker.UpdateHelper.exe" />
      <_UpdateHelperBuild Include="..\TimeTracker.UpdateHelper\bin\$(Configuration)\net8.0\TimeTracker.UpdateHelper.dll" />
      <_UpdateHelperBuild Include="..\TimeTracker.UpdateHelper\bin\$(Configuration)\net8.0\TimeTracker.UpdateHelper.deps.json" />
      <_UpdateHelperBuild Include="..\TimeTracker.UpdateHelper\bin\$(Configuration)\net8.0\TimeTracker.UpdateHelper.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_UpdateHelperBuild)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('%(_UpdateHelperBuild.Identity)')" />
  </Target>
  <Target Name="PublishUpdateHelper" AfterTargets="Publish">
    <MSBuild Projects="..\TimeTracker.UpdateHelper\TimeTracker.UpdateHelper.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=net8.0;RuntimeIdentifier=;SelfContained=false;PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)'))" />
  </Target>

</Project>
